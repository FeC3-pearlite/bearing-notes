{
  "name": "@local/bearing-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeC3-pearlite/bearing-notes.git"
  },
  "description": "Read literature and capture notes into one Word knowledge base, with a bearing-steel RCF review sidecar.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "lib/docx.mjs",
    "lib/store.mjs",
    "lib/domain.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
